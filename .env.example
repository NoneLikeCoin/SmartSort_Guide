# 配置模板：复制为 .env 后按需填写。.env 已被 .gitignore 忽略，切勿提交。
# 优先级：系统环境变量 > .env（.env 只补充缺失项）。

# mock 模式开关：1=固定数据全链路演示（无需模型/网络/密钥）
MOCK=1

# 真实运行所需（MOCK!=1 时生效）：
# YOLOv8 导出的 ONNX 模型路径（训练产物 best.onnx，不进仓库/镜像，按路径挂载）
# MODEL_PATH=D:/models/best.onnx

# DeepSeek API 密钥（投放建议智能体）——只放本地 .env，禁止写入代码或提交
# DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx

# 可选：投放规则库挂载路径（默认读项目内 data/rules.json）
# RULES_PATH=D:/deploy/rules.json
